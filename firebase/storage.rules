rules_version = '2';
// Wedding camera uploads: photos/{uid}/{file}. Guests upload only into their
// own folder, only images, max 15 MB. Viewing goes through the photo's
// Firestore record, so the files themselves are readable by signed-in users
// only when they know the exact path.
service firebase.storage {
  match /b/{bucket}/o {
    // Countdown pictures ("5 days to go"): family uploads, every guest sees them.
    match /countdown/{file} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email))
        && (request.resource == null || (request.resource.contentType.matches('image/.*') && request.resource.size < 15 * 1024 * 1024));
    }
    match /photos/{uid}/{file} {
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.contentType.matches('image/.*')
        && request.resource.size < 15 * 1024 * 1024;
      allow read: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.email != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email));
    }
  }
}
