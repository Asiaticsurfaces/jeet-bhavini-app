rules_version = '2';
// Jeet & Bhavini wedding app — who can read and write what.
//
// Everyone in the app is signed in: guests verify their mobile number by
// SMS OTP (or browse anonymously), family by OTP or Google. A family member
// is anyone whose phone ("+91…") or email has a doc in /admins.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function myPhone() { return request.auth.token.get('phone_number', ''); }
    function myEmail() {
      return request.auth.token.get('email_verified', false) == true
        ? request.auth.token.get('email', '') : '';
    }
    function isAdmin() {
      return signedIn() && (
        (myPhone() != '' && exists(/databases/$(db)/documents/admins/$(myPhone())))
        || (myEmail() != '' && exists(/databases/$(db)/documents/admins/$(myEmail()))));
    }
    function mine() { return signedIn() && resource.data.uid == request.auth.uid; }
    function creatingMine() { return signedIn() && request.resource.data.uid == request.auth.uid; }

    // Family allowlist. The very first family member to sign in to the
    // family panel claims it; the panel then writes config/adminsLocked so
    // nobody else can self-register. After that, admins add each other.
    match /admins/{email} {
      allow read: if isAdmin()
        || (signedIn() && (email == myPhone() || email == myEmail()));
      allow create: if isAdmin()
        || (signedIn() && email != '' && (email == myPhone() || email == myEmail())
            && !exists(/databases/$(db)/documents/config/adminsLocked));
      allow update, delete: if isAdmin();
    }

    // Guest pass, keyed by 10-digit phone: only the OTP-verified owner of
    // that number (or family) can read it. Nobody can list the guest list.
    match /guests/{phone} {
      allow get: if isAdmin() || (signedIn() && myPhone() == '+91' + phone);
      allow list, write: if isAdmin();
    }
    // Empty marker per invited number, so the app can say "not on the list"
    // before spending an SMS. Reveals nothing but that the number is invited.
    match /guestPhones/{phone} {
      allow get: if signedIn();
      allow list, write: if isAdmin();
    }
    // Private notes (food, health, family remarks): family only.
    match /guestNotes/{phone} {
      allow read, write: if isAdmin();
    }

    // Live updates and the "Happening now" banner: everyone reads, family writes.
    match /posts/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }
    match /config/{id}  { allow read: if signedIn(); allow write: if isAdmin(); }
    match /found/{id}   { allow read: if signedIn(); allow write: if isAdmin(); }

    // Things a guest sends: they see their own, family sees all.
    match /tickets/{id} {
      allow create: if creatingMine();
      allow read: if mine() || isAdmin();
      allow update, delete: if isAdmin();
    }
    match /lost/{id} {
      allow create: if creatingMine();
      allow read: if mine() || isAdmin();
      allow update, delete: if isAdmin();
    }
    // Arrival details, one per guest device; family assigns the driver.
    match /arrivals/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      // Guests can't set or change their own driver; family can.
      allow create: if (signedIn() && request.auth.uid == uid
                         && !request.resource.data.keys().hasAny(['driver'])) || isAdmin();
      allow update: if (signedIn() && request.auth.uid == uid
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['driver'])) || isAdmin();
      allow delete: if isAdmin();
    }
    match /rsvps/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /pushTokens/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // Shared walls: everyone reads, anyone signed in adds, family moderates.
    match /wishes/{id} {
      allow read: if signedIn();
      allow create: if creatingMine() && request.resource.data.text.size() <= 500;
      allow update, delete: if isAdmin();
    }
    match /songs/{id} {
      allow read: if signedIn();
      allow create: if creatingMine() && request.resource.data.title.size() <= 120;
      // Voting: only the vote count may change, by exactly +1.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.votes == resource.data.votes + 1;
      allow delete: if isAdmin();
    }

    // Wedding camera. Everyone sees photos family hasn't hidden; the app
    // keeps guest shots blurred until they "develop" (revealAt, 9 AM next day).
    match /photos/{id} {
      allow create: if creatingMine() && request.resource.data.hidden == false;
      allow read: if mine() || isAdmin()
        || (signedIn() && resource.data.hidden == false);
      allow update, delete: if isAdmin();
    }

    // Family-only planning.
    match /duties/{id}  { allow read, write: if isAdmin(); }
    match /vendors/{id} { allow read, write: if isAdmin(); }
    match /drivers/{id} { allow read, write: if isAdmin(); }
  }
}
