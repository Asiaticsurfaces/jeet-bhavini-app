rules_version = '2';
// Jeet & Bhavini wedding app — who can read and write what.
//
// Guests: signed in anonymously; they unlock their pass with their phone number.
// Staff: sign in to the family panel with Google. Each has a doc in /admins
// (keyed by email). role 'owner' can do everything (incl. guest import and
// managing people). Everyone else has tick-box permissions in `perms`:
//   live    – post live updates and the "Happening now" banner
//   help    – see and resolve help requests
//   lost    – lost & found
//   pickups – arrivals and driver assignment
//   guests  – guest list, RSVPs, private notes (read)
//   photos  – see all photos, hide/show, add photographer photos
//   team    – duties (tick done), add/edit vendors and drivers, contacts
//   events  – add and edit the wedding events (schedule) and the venue map
//   rooms   – add rooms (wing / area / beds) and allot them to guests by day
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() {
      return signedIn() && request.auth.token.get('email_verified', false) == true
        ? request.auth.token.get('email', '') : '';
    }
    function staffPath() { return /databases/$(db)/documents/admins/$(myEmail()); }
    function role() {
      return myEmail() != '' && exists(staffPath())
        ? get(staffPath()).data.get('role', 'family') : 'none';
    }
    function isOwner() { return role() == 'owner'; }
    function isStaff() { return role() != 'none'; }
    // Older entries without `perms` fall back to their preset.
    function preset(r) {
      return r == 'event' ? {'live': true}
        : r == 'family' ? {'help': true, 'lost': true, 'pickups': true, 'guests': true, 'photos': true, 'team': true, 'rooms': true}
        : {};
    }
    function can(p) {
      return isOwner() || (isStaff()
        && get(staffPath()).data.get('perms', preset(role())).get(p, false) == true);
    }
    function mine() { return signedIn() && resource.data.uid == request.auth.uid; }
    function creatingMine() { return signedIn() && request.resource.data.uid == request.auth.uid; }

    // Staff list. The very first person to sign in to the family panel
    // claims it as owner; the panel then writes config/adminsLocked. After
    // that only the owner adds or removes people and sets their role.
    match /admins/{email} {
      allow get: if isStaff() || (myEmail() != '' && myEmail() == email);
      allow list: if isOwner();
      allow create: if isOwner()
        || (myEmail() != '' && myEmail() == email
            && request.resource.data.role == 'owner'
            && !exists(/databases/$(db)/documents/config/adminsLocked));
      allow update, delete: if isOwner() && email != myEmail();
    }

    // Guest pass. Keyed by phone (older imports) or by a name id when the
    // guest list has no number. A guest fetches ONE record; nobody outside
    // the family can list them.
    match /guests/{phone} {
      allow get: if signedIn();
      allow list: if can('guests') || can('rooms');
      allow write: if isOwner();
      // Rooms tab writes only the room shown on the guest's pass.
      allow update: if can('rooms')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['room', 'roomWhere', 'stayIn', 'stayOut', 'roommates']);
    }
    // Name search for first login: tokens of each name. A guest may search
    // (20 results at most per query, so the list can't be dumped). ONE NAME,
    // ONE NUMBER: a guest claims a name only while it has no number
    // (`phones` empty), in the same batch as its phoneLinks entry. Family can
    // free a name again.
    match /guestIndex/{id} {
      allow get: if signedIn();
      allow list: if can('guests') || can('rooms') || (signedIn() && request.query.limit <= 20);
      allow write: if isOwner();
      allow update: if can('guests')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phones']);
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['phones'])
        && resource.data.get('phones', []).size() == 0
        && request.resource.data.phones.size() == 1
        && getAfter(/databases/$(db)/documents/phoneLinks/$(request.resource.data.phones[0])).data.guestId == id;
    }
    // Which guest a mobile number belongs to, saved when a guest picks their
    // name the first time. Lookup by exact number only.
    match /phoneLinks/{phone} {
      allow get: if signedIn();
      allow list: if can('guests') || can('rooms');
      allow create: if signedIn() && phone.matches('[0-9]{10}')
        && request.resource.data.keys().hasOnly(['guestId', 'name', 'at'])
        && exists(/databases/$(db)/documents/guests/$(request.resource.data.guestId))
        && getAfter(/databases/$(db)/documents/guestIndex/$(request.resource.data.guestId)).data.get('phones', []).hasAny([phone]);
      allow create, update, delete: if isOwner() || can('guests');
    }
    match /guestNotes/{phone} {
      allow read: if can('guests');
      allow write: if isOwner();
    }

    // Live updates and banner: everyone reads; owner and event team write.
    match /posts/{id} { allow read: if signedIn(); allow write: if can('live'); }
    match /config/{id} {
      allow read: if signedIn();
      allow write: if isOwner() || (id == 'now' && can('live')) || (id == 'map' && can('events'));
    }
    match /found/{id} { allow read: if signedIn(); allow write: if can('lost'); }

    // Things a guest sends: they see their own; family sees and updates all.
    match /tickets/{id} {
      allow create: if creatingMine();
      allow read: if mine() || can('help');
      allow update: if can('help');
      allow delete: if isOwner();
    }
    match /lost/{id} {
      allow create: if creatingMine();
      allow read: if mine() || can('lost');
      allow update: if can('lost');
      allow delete: if isOwner();
    }
    // Arrival details, one per guest device; family assigns the driver.
    match /arrivals/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || can('pickups');
      allow create: if (signedIn() && request.auth.uid == uid
                         && !request.resource.data.keys().hasAny(['driver'])) || can('pickups');
      allow update: if (signedIn() && request.auth.uid == uid
                         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['driver'])) || can('pickups');
      allow delete: if isOwner();
    }
    match /rsvps/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || can('guests');
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /pushTokens/{uid} {
      allow write: if signedIn() && request.auth.uid == uid;
      allow read: if isOwner();
    }

    // Shared walls: everyone reads, anyone signed in adds, family moderates.
    match /wishes/{id} {
      allow read: if signedIn();
      allow create: if creatingMine() && request.resource.data.text.size() <= 500;
      allow update: if isOwner();
      allow delete: if isOwner();
    }
    match /songs/{id} {
      allow read: if signedIn();
      allow create: if creatingMine() && request.resource.data.title.size() <= 120;
      // Voting: only the vote count may change, by exactly +1.
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes'])
        && request.resource.data.votes == resource.data.votes + 1;
      allow delete: if isOwner();
    }

    // Wedding camera. Everyone sees photos family hasn't hidden; the app
    // keeps guest shots blurred until they "develop" (revealAt, 9 AM next day).
    match /photos/{id} {
      allow create: if creatingMine() && request.resource.data.hidden == false;
      allow read: if mine() || can('photos')
        || (signedIn() && resource.data.hidden == false);
      allow update: if can('photos');
      allow delete: if isOwner();
    }

    // Planning. Team permission sees all and ticks duties done; owner edits (via import).
    match /duties/{id} {
      allow read: if can('team');
      allow update: if can('team')
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['done']);
      allow create, delete: if isOwner();
    }
    match /vendors/{id} { allow read: if can('team'); allow write: if can('team'); }
    match /drivers/{id} { allow read: if can('team') || can('pickups'); allow write: if can('team'); }

    // Wedding schedule: everyone reads; the events permission edits.
    match /events/{id} { allow read: if signedIn(); allow write: if can('events'); }

    // Room allotment (family panel → Rooms).
    match /rooms/{id} { allow read, write: if can('rooms'); }
    match /stays/{id} { allow read, write: if can('rooms'); }
  }
}
